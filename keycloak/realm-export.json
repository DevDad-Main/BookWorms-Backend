{
  "id": "bookworms",
  "realm": "bookworms",
  "displayName": "BookWorms",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Standard application user"
      },
      {
        "name": "ADMIN",
        "description": "Administrator"
      }
    ]
  },
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "oliver@mail.com",
      "firstName": "Oliver",
      "lastName": "Metz",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@bookworms.dev",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "admin"]
    }
  ],
  "clients": [
    {
      "clientId": "bookworms-client",
      "name": "BookWorms Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "user-uuid-as-sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "sub",
            "jsonType.label": "String"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:4200/*",
        "access.token.lifespan": "3600",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"]
    },
    {
      "clientId": "bookworms-backend",
      "name": "BookWorms Backend",
      "enabled": true,
      "publicClient": false,
      "secret": "your-secure-backend-secret-here",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "use.jwks.url": "false"
      }
    }
  ],
  "scopeMappings": [
    {
      "client": "bookworms-client",
      "roles": ["user", "admin"]
    }
  ]
}
